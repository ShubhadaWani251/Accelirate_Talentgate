# Direct dependencies only - the packages this codebase actually imports or configures.
# requirements.txt is the fully-pinned, resolved tree generated from this file:
#
#     pip install -r requirements.in && pip freeze > requirements.txt
#
# Keeping the two separate is why this file exists. requirements.txt had accumulated 17 packages
# nothing referenced (celery, django-celery-beat, django-axes, django-prometheus, drf-yasg,
# django-filter, django-oauth-toolkit, django-extensions, factory_boy, Faker, Werkzeug,
# django-environ, sendgrid, numpy, pandas, xlrd, prometheus_client) while MISSING python-dotenv,
# which settings.py imports on its very first line - so a clean install produced an app that
# could not start. A flat freeze cannot show that, because it does not distinguish "we asked for
# this" from "something else pulled it in".

# --- Framework ---
Django==6.0.8
djangorestframework==3.17.2
djangorestframework-simplejwt==5.5.1
django-cors-headers==4.9.0
django-ratelimit==4.1.0

# --- Configuration ---
# Imported by config/settings.py to load Backend/.env.
python-dotenv==1.2.2

# --- Database ---
psycopg2-binary==2.9.12

# --- Serving (production) ---
gunicorn==26.0.0
# Serves collected static files; Django serves none itself with DEBUG=False.
whitenoise==6.12.0

# --- Email ---
# Anymail provides the SendGrid fallback backend. The default transport is Microsoft Graph,
# implemented in api/services/graph_email.py directly on top of requests.
django-anymail==15.1
requests==2.34.2
# Signs the private_key_jwt client assertion for certificate-based Graph auth
# (graph_email._build_client_assertion) - an alternative to GRAPH_CLIENT_SECRET. RS256 needs the
# cryptography extra to load the PEM private key; declared directly rather than relying on it
# staying a transitive dependency of djangorestframework-simplejwt.
PyJWT[crypto]==2.13.0

# --- Spreadsheet upload/export ---
# Candidate and question bulk upload, and the xlsx exports. openpyxl only - the pandas/numpy/xlrd
# stack was pinned but never imported.
openpyxl==3.1.5

# --- Proctoring evidence storage ---
azure-storage-blob==12.24.0
# Ships a real static ffmpeg binary inside the wheel (platform-specific: win/linux/mac all
# covered) - services/video_transcode.py uses it to convert a candidate's WebM proctoring
# recording to MP4 for TA download. No system-level ffmpeg install needed anywhere, which matters
# because the one real deployment (App Service code-deploy, see README) has no apt-get access at
# all to install one the traditional way.
imageio-ffmpeg==0.6.0

# --- Aadhaar identity verification (exam-time identity capture, services/aadhaar.py) ---
# QR detection/decode of the candidate's photographed Aadhaar card. Ships as a self-contained
# wheel with no system libzbar install needed - same "wheel over system package" reasoning as
# imageio-ffmpeg above, since App Service's code-deploy has no apt-get access either.
opencv-python-headless==5.0.0.93
# RSA/X.509 signature verification for a UIDAI Secure QR. Already resolves into this tree
# transitively via PyJWT[crypto] above; declared directly here for the same reason PyJWT[crypto]
# itself is declared directly rather than relying on staying a transitive dependency.
cryptography==50.0.1
# OCR fallback for a card whose QR can't be decoded (no QR at all, or the newer Secure QR format
# this module doesn't parse). Free and fully local (pure pip install, ONNX models bundled in the
# wheel/first-run cache) - no cloud account, no per-call cost, unlike the Azure AI Vision
# integration this replaces, which was never actually provisioned in any environment.
#
# IMPORTANT: rapidocr-onnxruntime declares a hard dependency on the `opencv-python` PyPI package
# (not just "a cv2"), which pip cannot see is already satisfied by opencv-python-headless above -
# both packages install overlapping files under the same cv2/ directory, and having both present
# actively breaks cv2 (confirmed - installing both, or later removing just one, corrupts the
# other). Install this with `pip install --no-deps rapidocr-onnxruntime==1.2.3`, never a plain
# `pip install`, and never install opencv-python (non-headless) in this project. Its other real
# runtime dependencies (onnxruntime, Pillow, pyclipper, PyYAML, Shapely, six - confirmed via
# `pip show rapidocr-onnxruntime`) are declared explicitly below instead.
rapidocr-onnxruntime==1.2.3
onnxruntime==1.29.0
pillow==12.3.0
pyclipper==1.4.0
PyYAML==6.0.3
shapely==2.1.2
six==1.17.0

# --- Shared cache for rate-limit and login-lockout counters ---
# Used via django.core.cache.backends.redis.RedisCache when REDIS_URL is set. Without it those
# counters are per-process and every limit is effectively multiplied by the worker count.
redis==8.1.0

# --- Error reporting ---
# Initialised only when SENTRY_DSN is set.
sentry-sdk==2.66.1

# --- Timezone data ---
# Required on Windows, where the OS ships no zoneinfo database and USE_TZ=True needs one.
tzdata==2026.3

# --- Tests ---
pytest==9.1.1
pytest-django==4.12.0
# Generates a real QR image at test time (test_aadhaar.py) to prove decode_qr_payload against
# actual QR bytes rather than a mock - never imported outside tests.
qrcode==8.2
