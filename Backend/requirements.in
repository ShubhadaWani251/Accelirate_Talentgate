# --- Email ---
# Anymail provides the SendGrid fallback backend. The default transport is Microsoft Graph,
# implemented in api/services/graph_email.py directly on top of requests.
django-anymail==15.1
requests==2.34.2
# Signs the private_key_jwt client assertion for certificate-based Graph auth
# (graph_email._build_client_assertion) - an alternative to GRAPH_CLIENT_SECRET. RS256 needs the
# cryptography extra to load the PEM private key; declared directly rather than relying on it
# staying a transitive dependency of djangorestframework-simplejwt.
PyJWT[crypto]==2.13.0

# --- Spreadsheet upload/export ---
# Candidate and question bulk upload, and the xlsx exports. openpyxl only - the pandas/numpy/xlrd
# stack was pinned but never imported.
openpyxl==3.1.5

# --- Proctoring evidence storage ---
azure-storage-blob==12.24.0
# Ships a real static ffmpeg binary inside the wheel (platform-specific: win/linux/mac all
# covered) - services/video_transcode.py uses it to convert a candidate's WebM proctoring
# recording to MP4 for TA download. No system-level ffmpeg install needed anywhere, which matters
# because the one real deployment (App Service code-deploy, see README) has no apt-get access at
# all to install one the traditional way.
imageio-ffmpeg==0.6.0

# --- Aadhaar identity verification (exam-time identity capture, services/aadhaar.py) ---
# QR detection/decode of the candidate's photographed Aadhaar card. Ships as a self-contained
# wheel with no system libzbar install needed - same "wheel over system package" reasoning as
# imageio-ffmpeg above, since App Service's code-deploy has no apt-get access either.
opencv-python-headless==5.0.0.93
# RSA/X.509 signature verification for a UIDAI Secure QR. Already resolves into this tree
# transitively via PyJWT[crypto] above; declared directly here for the same reason PyJWT[crypto]
# itself is declared directly rather than relying on staying a transitive dependency.
cryptography==50.0.1
# OCR fallback for a card whose QR can't be decoded (no QR at all, or the newer Secure QR format
# this module doesn't parse). Free and fully local (pure pip install, ONNX models bundled in the
# wheel/first-run cache) - no cloud account, no per-call cost.
#
# rapidocr-onnxruntime ITSELF IS DELIBERATELY NOT LISTED HERE. Its own metadata hard-depends on
# the `opencv-python` PyPI package (the GUI/full build, not opencv-python-headless above) -
# confirmed by `pip install --dry-run --report` on this exact pin, which resolves opencv-python
# regardless of opencv-python-headless already being present. A plain `pip install -r
# requirements.txt` cannot exclude one package's transitive dependency, so listing
# rapidocr-onnxruntime in this file at all means production gets BOTH opencv packages installed,
# overwriting each other's files under the same cv2/ directory - and whichever copy of cv2 ends up
# on disk needing libGL.so.1 (opencv-python's real requirement) crashes on the App Service Linux
# runtime, which has no apt-get access to install it and no GUI libs by default. cv2 is imported
# at module scope in services/aadhaar.py (existing, for QR decoding), so that import failure takes
# down the entire app at Django startup, not just the OCR code path - this exact chain is what
# caused the 2026-09-10 production outage.
#
# The fix: install rapidocr-onnxruntime with `pip install --no-deps` as its own separate step,
# AFTER this file's normal install - wired into Backend/Dockerfile, Backend/startup.sh, and
# azure-pipelines.yml (search each for "rapidocr-onnxruntime --no-deps"). All of its OTHER real
# runtime dependencies (confirmed via `pip show rapidocr-onnxruntime`) are declared explicitly
# below instead, so `--no-deps` only ever has to skip the one problematic line, never a package
# this app actually needs installed some other way.
onnxruntime==1.29.0
numpy==2.5.3
pillow==12.3.0
pyclipper==1.4.0
PyYAML==6.0.3
shapely==2.1.2
six==1.17.0

# --- Shared cache for rate-limit and login-lockout counters ---
# Used via django.core.cache.backends.redis.RedisCache when REDIS_URL is set. Without it those
# counters are per-process and every limit is effectively multiplied by the worker count.
redis==8.1.0

# --- Error reporting ---
# Initialised only when SENTRY_DSN is set.
sentry-sdk==2.66.1

# --- Timezone data ---
# Required on Windows, where the OS ships no zoneinfo database and USE_TZ=True needs one.
tzdata==2026.3

