# Copy this file to .env and fill in real values. Never commit the real .env file -
# it's already gitignored. Every variable below is read in config/settings.py; this file
# lists them all so a new developer doesn't have to grep settings.py to find out what's needed.

# --- Core Django ---
# Generate a real one for anything beyond local dev: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-for-any-non-local-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres) ---
DB_NAME=talentgate
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
# Connection pooling for a remote DB - 0 disables it (a fresh connection per request).
DB_CONN_MAX_AGE=0

# --- Frontend origin (CORS + links embedded in outgoing emails) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth / OTP policy ---
CORPORATE_EMAIL_DOMAIN=accelirate.com
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_HISTORY_COUNT=5

# --- Email ---
# EMAIL_BACKEND selects the transport. Two are wired up:
#   api.services.graph_email.GraphEmailBackend   (Microsoft Graph - default)
#   anymail.backends.sendgrid.EmailBackend        (SendGrid - Anymail has dropped support for
#                                                  this provider upstream; kept as a fallback)
EMAIL_BACKEND=api.services.graph_email.GraphEmailBackend
DEFAULT_FROM_EMAIL=noreply@accelirate.com
# Address printed in candidate-facing emails as the contact for technical issues - must be a
# real monitored mailbox, not the noreply address above.
SUPPORT_EMAIL=

# Microsoft Graph (required when EMAIL_BACKEND is GraphEmailBackend) - needs an Azure AD app
# registration with application-level (not delegated) Mail.Send permission and admin consent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SENDER=
GRAPH_SAVE_TO_SENT_ITEMS=false
# Either the secret below, or both cert values below that - cert is preferred when both are set.
# See api/management/commands/generate_graph_cert.py to produce a key pair and these values.
GRAPH_CLIENT_SECRET=
GRAPH_CERT_PATH=
GRAPH_CERT_THUMBPRINT=

# Pacing/retry policy for candidate invitation emails (management/commands/
# process_email_queue.py - the only thing that actually sends one) - both have sensible
# defaults, override only if you have a specific reason to.
INVITE_SEND_DELAY_SECONDS=1.5
INVITE_MAX_RETRY_ATTEMPTS=5

# SendGrid (only used if EMAIL_BACKEND points at the Anymail/SendGrid backend above)
SENDGRID_API_KEY=

# --- Azure Blob Storage (candidate exam-taking portal - identity photos + session recording) ---
# Left blank + DEBUG=True falls back to local disk (media/) automatically - no local Azure
# account needed to test the exam flow. LOCAL_MEDIA_BASE_URL only matters for that fallback.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_EVIDENCE=proctoring-evidence
LOCAL_MEDIA_BASE_URL=http://127.0.0.1:8000

# --- Production transport hardening (leave False for local dev) ---
ENABLE_SSL_REDIRECT=False
TRUST_X_FORWARDED_FOR=False

# --- Optional infrastructure (declared in requirements.txt for future use; not yet wired
# into INSTALLED_APPS/MIDDLEWARE - Celery task queue, if/when it's adopted) ---
REDIS_URL=

# --- Timezone for candidate-facing text ---
# Storage is always UTC. This is the zone that invitation emails render exam windows in, and it
# is named explicitly in the text, because there is no browser present to localize it the way
# the staff UI does. See services/email_templates.format_datetime.
DISPLAY_TIME_ZONE=Asia/Kolkata

# --- Refresh-token cookie ---
# Strict is correct when the frontend and API share an origin, which is how the Docker stack
# deploys them (nginx proxies /api/ to the backend - see Frontend/nginx.conf). Set to None ONLY
# if they end up on genuinely different sites, and note browsers ignore None on a non-HTTPS
# cookie, so that combination requires TLS.
REFRESH_COOKIE_SAMESITE=Strict

# --- Proctoring evidence URL lifetime ---
# How many minutes a signed evidence URL stays valid. Signed fresh on every read, so this only
# needs to be long enough to download one session recording, not long enough to archive it.
EVIDENCE_URL_TTL_MINUTES=120

# --- Logging ---
# Application log level. Defaults to DEBUG when DEBUG=True, otherwise INFO.
LOG_LEVEL=INFO
# Every SQL statement, when set to DEBUG. Left at WARNING because the output is enormous and
# echoes query parameters, which here include candidate PII.
SQL_LOG_LEVEL=WARNING

# --- Error reporting (optional) ---
# Leave SENTRY_DSN blank to disable error reporting entirely. Nothing is sent anywhere unless
# it is set. PII is never attached (send_default_pii=False in settings.py).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0 disables performance tracing; this is configured as an error reporter, not an APM.
SENTRY_TRACES_SAMPLE_RATE=0
