# Copy this file to .env and fill in a real value. Never commit the real .env file -
# it's already gitignored.

# Base URL the frontend sends API requests to (see src/api/axiosClient.js).
VITE_API_BASE_URL=http://localhost:8000/api

# --- Single sign-on (Microsoft work account) -------------------------------
# Both must be set for the "Sign in with Microsoft" button to appear; with either blank the
# login screen shows the password form alone (see src/features/auth/msal.isSsoConfigured).
# These must match SSO_CLIENT_ID / SSO_TENANT_ID in Backend/.env - the backend refuses any
# token whose audience or directory is not exactly these.
#
# The Entra app registration needs platform type "Single-page application" with a redirect URI
# matching the origin this runs on - http://localhost:5173 for local development.
VITE_SSO_CLIENT_ID=
VITE_SSO_TENANT_ID=
