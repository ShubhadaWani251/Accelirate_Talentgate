# --- Backend (Django) ---
Backend/venv/
**/__pycache__/
*.pyc
Backend/db.sqlite3
Backend/.env
Backend/.admin_credentials.txt
Backend/.gmail_test_admin_credentials.txt
# Throwaway local review stack - a SQLite copy with invented candidates, the settings module
# that points at it, and the logins for it. None of it is a production path, and the passwords
# are real passwords even though the data behind them is not.
Backend/.local_demo_credentials.txt
Backend/local_demo.sqlite3
Backend/settings_localdemo.py
Backend/media/
Backend/logs/
Backend/staticfiles/
# Generated by manage.py generate_graph_cert - a private key belongs nowhere in source control.
Backend/certs/
# Frontend build copied in at deploy time (see FRONTEND_DIST) - a build artifact, not source.
Backend/frontend/
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code local state ---
.claude/settings.local.json

# Local DB backups - recovery artifacts, not source
backups/

# Cross-project tracking sheet that happens to sit in this folder. It carries staging/production
# database passwords for every Accelirate Labs project, not just this one, so committing it would
# put a dozen unrelated credentials in this repo's history permanently.
Accelirate Labs-Project list*.csv
